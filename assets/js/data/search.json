---
layout: null
---
[{% for post in site.posts %}{"title":{{ post.title | jsonify }},"url":{{ post.url | relative_url | jsonify }},"categories":{{ post.categories | join: ', ' | jsonify }},"tags":{{ post.tags | join: ', ' | jsonify }},"description":{{ post.description | default: post.excerpt | strip_html | normalize_whitespace | truncate: 220 | jsonify }},"content":{{ post.content | strip_html | normalize_whitespace | jsonify }}}{% unless forloop.last %},{% endunless %}{% endfor %}]
