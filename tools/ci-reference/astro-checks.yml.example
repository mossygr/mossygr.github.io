name: Astro source checks
on:
  pull_request:
  push:
    branches: ['feat/retro-amber-a']
  workflow_dispatch:
permissions:
  contents: read
jobs:
  check:
    runs-on: ubuntu-latest
    env:
      ASTRO_TELEMETRY_DISABLED: '1'
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: '24'
          cache: npm
      - run: npm ci
      - run: npm test
      - run: npm run build
      - uses: actions/upload-artifact@v4
        with:
          name: astro-minimal-amber-build
          path: dist/
# Preview publication is managed separately; this workflow never deploys Pages.
