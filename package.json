{
  "name": "m0ss1-documentation",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "prepare:assets": "node tools/prepare-public.mjs",
    "dev": "npm run prepare:assets && astro dev --host 0.0.0.0",
    "check": "astro check",
    "build": "npm run prepare:assets && astro check && astro build && node tools/build-search.mjs && node tools/audit-dist.mjs",
    "preview": "astro preview --host 0.0.0.0",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.4",
    "@astrojs/mdx": "8.1.1",
    "@fontsource-variable/inter": "^5.3.0",
    "astro": "7.4.2",
    "pagefind": "1.5.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3"
  }
}
